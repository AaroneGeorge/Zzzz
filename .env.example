BITREFILL_API_KEY=
BITREFILL_MODE=offline        # test | real | offline
ZEC_NETWORK=testnet
ZEC_WALLET=mock               # zecli | zingo | manual | mock
ZCLI_IDENTITY=./.secrets/zcash_ed25519
ZEC_DEST_ADDRESS=
WALLET_TXID_OVERRIDE=
ONECLICK_JWT=
ANTHROPIC_API_KEY=
AGENT_MODE=scripted           # llm | scripted
AGENT_MODEL=claude-sonnet-5-5
PORT=3000
# Shielded payment gateway (merchant side). ufvk = view-only wallet from the gateway UFVK (default with ZEC_WALLET=zingo),
# wallet = the gateway's full wallet, mock = in-memory (default otherwise)
GATEWAY_MODE=
GATEWAY_TIMEOUT_MS=720000     # no verified payment within this time -> no Bitrefill order
GATEWAY_POLL_MS=10000
GATEWAY_TESTNET_SCALE=1       # testnet TAZ sent = quoted mainnet ZEC x scale, clamped to 0.001-0.01
